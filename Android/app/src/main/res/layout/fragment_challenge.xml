<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">


    <!-- =====================================================
         CHALLENGE PANEL
         ===================================================== -->

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">


        <!-- =================================================
             TITLE
             ================================================= -->

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTask1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="0dp"
                android:text="Task 1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/odyssey_navy" />

            <Button
                android:id="@+id/btnTask2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:text="Task 2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/odyssey_text_muted"
                android:backgroundTint="@color/control_inactive" />

        </LinearLayout>
        <!-- STATUS -->

        <TextView
            android:id="@+id/challengeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Ready"
            android:textColor="@color/odyssey_text_muted"
            android:textSize="13sp" />


        <!-- =================================================
             SPACE BETWEEN HEADER AND TIMER
             ================================================= -->

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.45" />


        <!-- =================================================
             TIMER
             ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/odyssey_parchment">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ELAPSED TIME"
                android:textColor="@color/odyssey_bronze_light"
                android:textSize="12sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/challengeTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:text="00:00.00"
                android:textColor="@color/odyssey_navy"
                android:textSize="38sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- =================================================
             SPACE BETWEEN TIMER AND ACTIONS
             ================================================= -->

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.55" />


        <!-- =================================================
             DIVIDER
             ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/odyssey_bronze_light" />


        <!-- =================================================
             ACTION BUTTONS
             ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">


            <!-- START -->

            <Button
                android:id="@+id/btnChallengeStart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minHeight="0dp"
                android:text="Start"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/control_active" />


            <!-- STOP / RESET -->

            <Button
                android:id="@+id/btnChallengeStop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:enabled="false"
                android:text="Stop"
                android:textColor="@color/odyssey_text_muted"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/control_inactive" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>