<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/odyssey_cream"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp">


    <!-- ================================================= -->
    <!-- TITLE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/dialogObstacleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Obstacle 1"
        android:textColor="@color/odyssey_navy"
        android:textSize="18sp"
        android:textStyle="bold" />


    <!-- ================================================= -->
    <!-- COORDINATES -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/dialogObstacleCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="X: 5    Y: 8"
        android:textColor="@color/odyssey_text_muted"
        android:textSize="12sp" />


    <!-- ================================================= -->
    <!-- TARGET ID -->
    <!-- Hidden unless target exists -->
    <!-- ================================================= -->




    <!-- ================================================= -->
    <!-- DIVIDER -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/odyssey_bronze_light" />


    <!-- ================================================= -->
    <!-- ORIENTATION LABEL -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Change Orientation"
        android:textColor="@color/odyssey_navy"
        android:textSize="13sp"
        android:textStyle="bold" />


    <!-- ================================================= -->
    <!-- COMPASS -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="vertical">


        <!-- NORTH -->

        <Button
            android:id="@+id/dialogNorth"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:text="NORTH"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/odyssey_text_muted"
            android:backgroundTint="@color/control_inactive" />


        <!-- WEST / EAST -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:orientation="horizontal">


            <Button
                android:id="@+id/dialogWest"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="WEST"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/odyssey_text_muted"
                android:backgroundTint="@color/control_inactive" />


            <Space
                android:layout_width="24dp"
                android:layout_height="1dp" />


            <Button
                android:id="@+id/dialogEast"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="EAST"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/odyssey_text_muted"
                android:backgroundTint="@color/control_inactive" />

        </LinearLayout>


        <!-- SOUTH -->

        <Button
            android:id="@+id/dialogSouth"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:text="SOUTH"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/odyssey_text_muted"
            android:backgroundTint="@color/control_inactive" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- DIVIDER -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/odyssey_bronze_light" />


    <!-- ================================================= -->
    <!-- ACTIONS -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">


        <!-- REMOVE -->

        <Button
            android:id="@+id/dialogRemove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:minHeight="0dp"
            android:text="REMOVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/status_red" />


        <!-- SAVE -->

        <Button
            android:id="@+id/dialogSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:minHeight="0dp"
            android:text="SAVE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/control_active" />

    </LinearLayout>

</LinearLayout>