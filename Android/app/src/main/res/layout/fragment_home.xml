<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">


    <!-- GRID + STATUS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="45"
        android:orientation="horizontal">


        <com.example.mdpgroup24.views.ArenaGridView
            android:id="@+id/arenaGridView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:background="#FFFFFF" />


        <!-- VESSEL STATUS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_panel">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Vessel"
                android:textColor="@color/odyssey_bronze_light"
                android:textSize="36sp"
                android:textStyle="bold" />


            <!-- STATUS BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textSize="13sp"
                    android:textColor="#777777" />

                <TextView
                    android:id="@+id/vesselStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Offline"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/vesselTaskStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="--"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>


            <!-- DIRECTION BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direction"
                    android:textSize="13sp"
                    android:textColor="#777777" />

                <TextView
                    android:id="@+id/vesselDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="--"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>


            <!-- COORDINATES BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coordinates"
                    android:textSize="13sp"
                    android:textColor="#777777" />

                <TextView
                    android:id="@+id/vesselCoordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="X: --    Y: --"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- BOTTOM SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40"
        android:orientation="vertical"
        android:background="@color/odyssey_navy"
        android:padding="12dp">


        <!-- SUBTABS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:id="@+id/subTabBar"
            android:orientation="horizontal"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:padding="0dp"
            android:background="@drawable/bg_subtab_container"
            android:clipToOutline="true">

            <TextView
                android:id="@+id/tabConfiguration"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Configuration"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabControl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#C8C8C8"
                android:gravity="center"
                android:text="Control"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Chat"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabChallenge"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Challenge"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_subpage"
            android:padding="1dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/subTabViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>